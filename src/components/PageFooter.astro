---
import { tinaField } from '@tinacms/astro/tina-field';
import type { FooterConfig } from '../lib/data';

interface Props {
  data?: FooterConfig | null;
}

const { data } = Astro.props;
const year = new Date().getFullYear();
const addressLines = (data?.addressLines ?? []).filter(Boolean);

const formAction = data?.newsletterFormAction ?? undefined;
const params = new URLSearchParams(formAction?.replaceAll('&amp;', '&').split('?')[1]);
const honeypotName = params.get('u') && params.get('id') ? `b_${params.get('u')}_${params.get('id')}` : undefined;
---

<footer class="bg-black pt-8 md:pt-40 pb-20 px-8 sm:px-0">
  <div class="container mx-auto mb-8 lg:mb-20">
    <div class="grid grid-cols-1 md:grid-cols-3">
      <div class="col-span-3 md:col-span-2 mb-8">
        <label
          class="flex text-white text-2xl font-serif mb-6"
          for="mce-EMAIL"
          data-tina-field={data && tinaField(data, 'newsletterTitle')}
        >
          {data?.newsletterTitle}
        </label>
        <div id="mc_embed_shell">
          <div id="mc_embed_signup">
            <form
              action={formAction}
              data-tina-field={data && tinaField(data, 'newsletterFormAction')}
              method="post"
              id="mc-embedded-subscribe-form"
              name="mc-embedded-subscribe-form"
              class="validate"
              target="_self"
            >
              <div class="md:flex">
                <input
                  type="email"
                  name="EMAIL"
                  id="mce-EMAIL"
                  required
                  placeholder={data?.newsletterPlaceholder ?? undefined}
                  data-tina-field={data && tinaField(data, 'newsletterPlaceholder')}
                  class="p-4 text-white w-full md:max-w-64 mb-4 md:mb-0 border-2 border-white"
                />
                <div class="flex">
                  <button
                    class="inline-flex w-full md:w-auto cursor-pointer font-serif border-2 text-white border-white hover:text-primary-500 hover:border-primary-500 p-4"
                    type="submit"
                    name="subscribe"
                    id="mc-embedded-subscribe"
                    data-tina-field={data && tinaField(data, 'newsletterButtonText')}
                  >
                    {data?.newsletterButtonText}
                  </button>
                </div>
              </div>
              <div class="flex p-4">
                <div id="bright-lives-validation-errors" class="text-red-500">
                  <div id="validation-error-slot" style="display: none;"></div>
                </div>
                <div id="mce-responses" class="clear foot text-white">
                  <div class="response" id="mce-error-response" style="display: none;"></div>
                  <div class="response" id="mce-success-response" style="display: none;"></div>
                </div>
                <!-- real people should not fill this in -->
                {honeypotName && (
                  <div aria-hidden="true" style="position: absolute; left: -5000px;">
                    <input type="text" name={honeypotName} tabindex="-1" value="" />
                  </div>
                )}
              </div>
            </form>
          </div>
        </div>
      </div>
      <div class="col-span-3 md:col-span-1">
        <span
          class="flex text-white text-2xl font-serif mb-6"
          data-tina-field={data && tinaField(data, 'contactTitle')}
        >
          {data?.contactTitle}
        </span>
        <ul>
          {addressLines.map((line, i) => (
            <li
              class:list={['text-white', { 'mb-2': i === addressLines.length - 1 }]}
              data-tina-field={data && tinaField(data, 'addressLines', i)}
            >
              {line}
            </li>
          ))}
          {data?.email && (
            <li class="text-white">
              <a
                class="text-primary-100 hover:text-white underline underline-offset-4"
                href={`mailto:${data.email}`}
                title={`E-mail naar ${data.email}`}
                data-tina-field={tinaField(data, 'email')}
              >
                {data.email}
              </a>
            </li>
          )}
        </ul>
      </div>
    </div>
  </div>
  <div class="container mx-auto border-t border-primary-600 pt-8 lg:pt-20">
    <p class="font-sans text-white" data-tina-field={data && tinaField(data, 'copyright')}>
      © {year} {data?.copyright}
    </p>
  </div>
</footer>
