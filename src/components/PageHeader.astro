---
import menuData from '../content/menu/index.json';

const menuItems = (menuData.items || [])
  .map((item) => {
    // Extract filename from full path (e.g., "content/pages/projecten.md" -> "projecten")
    const filename = item.page.split('/').pop().replace('.md', '');
    return {
      label: item.label,
      href: filename === 'homepage' ? '/' : `/${filename}`,
      order: item.order,
    };
  })
  .sort((a, b) => (a.order || 0) - (b.order || 0));

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => href === currentPath;
const isLast = (index: number) => index === menuItems.length - 1;
---

<header class="relative w-full z-30 bg-radial-gradient over-hero:absolute over-hero:bg-none">
  <div class="container mx-auto flex pb-6 px-8 sm:px-0">
    <div class="mr-auto">
      <a href="https://www.brightlives.nl">
        <img src="/logo-white.svg" alt="Bright lives logo" width="200" height="50" class="pt-6">
      </a>
    </div>
    <div class="flex items-center gap-8 sm:pr-6 pt-8">
      <nav class="hidden md:flex items-center gap-6">
        {menuItems.map((item, index) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'relative transition-colors duration-300',
              'after:absolute after:h-0.5 after:bg-current after:origin-left after:transition-transform after:duration-300 after:ease-out motion-reduce:after:transition-none',
              isLast(index)
                ? 'px-4 py-2 border-2 border-white bg-white text-primary-500 hover:bg-transparent hover:text-white after:inset-x-4 after:bottom-1'
                : 'py-2 text-white hover:text-primary-100 after:inset-x-0 after:bottom-0',
              isActive(item.href) ? 'after:scale-x-100' : 'after:scale-x-0 hover:after:scale-x-100',
            ]}
          >
            {item.label}
          </a>
        ))}
      </nav>
      <button
        id="menu-toggle"
        type="button"
        class="md:hidden text-white"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Menu"
      >
        <svg id="icon-bars" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="30" height="30" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
        <svg id="icon-cross" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" width="20" height="20" class="hidden m-1.25" aria-hidden="true">
          <path fill-rule="evenodd" d="M0 14.545L1.455 16 8 9.455 14.545 16 16 14.545 9.455 8 16 1.455 14.545 0 8 6.545 1.455 0 0 1.455 6.545 8z" />
        </svg>
      </button>
    </div>
  </div>
  <nav id="mobile-menu" class="hidden md:hidden absolute top-full left-0 w-full bg-primary-500">
    <ul class="flex flex-col">
      {menuItems.map((item, index) => (
        <li class="flex">
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'p-8 w-full transition-colors duration-300',
              isLast(index)
                ? ['text-primary-500 hover:bg-primary-100', isActive(item.href) ? 'bg-primary-100' : 'bg-white']
                : ['text-white hover:bg-primary-800', isActive(item.href) && 'bg-primary-800'],
            ]}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const menuToggle = document.getElementById('menu-toggle');

  menuToggle?.addEventListener('click', () => {
    const isOpen = !document.getElementById('mobile-menu')!.classList.toggle('hidden');

    menuToggle.setAttribute('aria-expanded', String(isOpen));
    document.getElementById('icon-bars')!.classList.toggle('hidden', isOpen);
    document.getElementById('icon-cross')!.classList.toggle('hidden', !isOpen);
  });
</script>
