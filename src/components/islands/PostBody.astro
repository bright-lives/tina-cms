---
import { tinaField } from '@tinacms/astro/tina-field';
import TinaMarkdown from '@tinacms/astro/TinaMarkdown.astro';
import PostTags from '../post-tags/PostTags.astro';
import type { CmsPost } from '../../lib/data';

interface Props {
  data?: CmsPost | null;
}

const { data } = Astro.props;
---
{data && (
  <section class="md:mx-auto max-w-4xl mt-8 md:m-16 bg-white p-8 md:p-20">
    <div class="grid grid-cols-1">
      <div class="mb-12">
        <div data-tina-field={tinaField(data, 'tags')}>
          <PostTags tags={data.tags} class="mt-10" />
        </div>
        <h1 class="text-4xl leading-normal font-serif mb-6" data-tina-field={tinaField(data, 'title')}>{data.title}</h1>
        <div class="prose" data-tina-field={tinaField(data, 'excerpt')}>
          <p>{data.excerpt}</p>
        </div>
      </div>
      <div data-tina-field={tinaField(data, 'image')}>
        {data.image && <img src={data.image} alt={data.imageAlt ?? ''} decoding="async" fetchpriority="high" />}
      </div>
    </div>
    <div class="mt-12 prose" data-tina-field={tinaField(data, 'body')}>
      <TinaMarkdown content={data.body} />
    </div>
  </section>
)}
