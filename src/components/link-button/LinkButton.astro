---
import type { ButtonData } from '../../lib/data';

interface Props { data: Omit<ButtonData, 'url'> & { url: string } }

const { data } = Astro.props;
const { text, url } = data;
const style = data.style ?? 'fill';
const variant = data.variant ?? 'normal';

const stylesMap: Record<string, Record<string, string>> = {
  fill: {
    normal: 'p-4 border-2 text-white fill-white bg-primary-500 border-primary-500 hover:text-primary-500 hover:fill-primary-500 hover:bg-white hover:border-white',
    inverted: 'p-4 border-2 text-primary-500 fill-primary-500 bg-white border-white hover:text-white hover:fill-white hover:bg-primary-500 hover:border-primary-500',
  },
  outline: {
    normal: 'p-4 border-2 text-black fill-black border-black hover:text-primary-500 hover:fill-primary-500 hover:border-primary-500',
    inverted: 'p-4 border-2 text-white fill-white border-white hover:text-primary-900 hover:fill-primary-900 hover:border-primary-900',
  },
  textOnly: {
    normal: 'py-4 text-primary-500 fill-primary-500 hover:text-primary-800 hover:fill-primary-800',
    inverted: 'py-4 text-white fill-white underline hover:text-white hover:fill-white hover:no-underline',
  },
};

const linkClass = `group inline-flex w-auto min-w-56 font-serif ${stylesMap[style]?.[variant] ?? stylesMap.fill.normal}`;
---

{text && (
  <a href={url} class={linkClass}>
    <span class="flex">{text}</span>
    <span class="flex ml-auto items-center pl-2 transition-all duration-300 ease-in-out group-hover:pl-4">
      <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
        <path d="M12.4 3.4 11.3 4.5l5.7 5.8H3.5v1.5h13.6l-5.7 5.7 1.1 1.1 7.6-7.6z" />
      </svg>
    </span>
  </a>
)}
