---
import { tinaField } from "@tinacms/astro/tina-field";
import type { SectionDownloadsSection } from "../../lib/data";

interface Props {
  data: SectionDownloadsSection;
}

const { data } = Astro.props;
const files = (data.files ?? []).filter((file) => file !== null);

// "/uploads/jaarverslag-2025.pdf" → "PDF"
const fileType = (path: string) => path.split(".").pop()?.toUpperCase();
---

<section class="container mx-auto grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-8 py-24 px-8 sm:px-0">
  <div class="max-w-lg">
    <h2 class="text-4xl leading-normal font-serif mb-6" data-tina-field={tinaField(data, "title")}>
      {data.title}
    </h2>
    {data.content && (
      <p data-tina-field={tinaField(data, "content")}>{data.content}</p>
    )}
  </div>
  <ul class="border-t-2 border-primary-500" data-tina-field={tinaField(data, "files")}>
    {files.map((file) => (
      <li class="border-b-2 border-primary-500" data-tina-field={tinaField(file)}>
        <a href={file.file ?? undefined} class="group flex items-center gap-4 py-5" data-tina-field={tinaField(file, "file")}>
          <span class="flex-grow">
            <span class="block font-serif text-xl group-hover:text-primary-500" data-tina-field={tinaField(file, "title")}>
              {file.title}
            </span>
            {file.description && (
              <span class="block text-secondary-400" data-tina-field={tinaField(file, "description")}>
                {file.description}
              </span>
            )}
          </span>
          {file.file && (
            <>
              <span class="text-sm font-bold text-primary-500">{fileType(file.file)}</span>
              <svg viewBox="0 0 24 24" width="24" height="24" class="fill-primary-500 shrink-0 transition-transform group-hover:translate-y-0.5" aria-hidden="true">
                <path d="M11.25 3v12.19l-4.72-4.72-1.06 1.06L12 18.06l6.53-6.53-1.06-1.06-4.72 4.72V3zM4.5 19.5V21h15v-1.5z" />
              </svg>
            </>
          )}
        </a>
      </li>
    ))}
  </ul>
</section>
