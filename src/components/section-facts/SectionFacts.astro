---
// Mirrors bright-lives-blocks/section-facts/{save,style}.js (+ __components__/common-style.js headings.column)
import { tinaField } from "@tinacms/astro/tina-field";
import TinaMarkdown from "@tinacms/astro/TinaMarkdown.astro";
import type { SectionFactsSection } from "../../lib/data";

interface Props {
  data: SectionFactsSection;
}

const { data } = Astro.props;
const facts = (data.facts ?? []).filter((fact) => fact !== null);
---

<section
  class="container mx-auto grid grid-cols-1 grid-cols-4 gap-x-4 gap-y-8 lg:gap-y-12 pb-10 mt-14 px-10 md:px-0"
  data-tina-field={tinaField(data, "facts")}
>
  {facts.map((fact) => (
    <Fragment>
      <div class="col-span-2">
        <h3 class="text-2xl leading-normal font-serif" data-tina-field={tinaField(fact, "title")}>
          {fact.title}
        </h3>
      </div>
      <div class="col-span-2 max-w-2xl prose" data-tina-field={tinaField(fact, "content")}>
        <TinaMarkdown content={fact.content} />
      </div>
    </Fragment>
  ))}
</section>
