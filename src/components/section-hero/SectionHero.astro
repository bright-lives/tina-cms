---
import { tinaField } from '@tinacms/astro/tina-field';
import type { HeroSection } from '../../lib/data';
import LinkButton from '../link-button/LinkButton.astro';

interface Props { data: HeroSection }

const { data } = Astro.props;
---

<section data-hero class="grid [grid-template-areas:'stack']">
  <div class="[grid-area:stack] z-20 container mx-auto px-8 sm:px-0">
    <div class="mt-60">
      <h1 class="text-hero-heading mb-8 text-white">{data.heading}</h1>
      <div data-tina-field={tinaField(data, 'button')}>
        {data.button && <LinkButton data={data.button} />}
      </div>
    </div>
  </div>
  <div class="[grid-area:stack] bg-radial-gradient-opacity z-10" />
  <div class="[grid-area:stack] z-0 relative" data-tina-field={tinaField(data, 'image')}>
    {data.image?.src && (
      <img
        src={data.image.src}
        alt={data.image.alt ?? ''}
        fetchpriority="high"
        loading="eager"
        decoding="async"
        class="absolute inset-0 size-full object-cover object-center"
      />
    )}
    <div class="relative bg-radial-gradient-opacity min-h-107.5 h-60vh max-h-125" />
  </div>
</section>
