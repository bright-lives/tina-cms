---
import { tinaField } from "@tinacms/astro/tina-field";
import type { SectionPeopleSection } from "../../lib/data";
import SectionContainer from "../section-container/SectionContainer.astro";

interface Props {
  data: SectionPeopleSection;
}

const { data } = Astro.props;
const people = (data.people ?? []).filter((person) => person !== null);

// Shown in place of a missing photo: "Ama Owusu" → "AO"
const initials = (name?: string | null) =>
  (name ?? "").split(/\s+/).filter(Boolean).map((part) => part[0]).slice(0, 2).join("").toUpperCase();
---

<SectionContainer>
  <div class="max-w-lg mb-12">
    <h2 class="text-4xl leading-normal font-serif mb-6" data-tina-field={tinaField(data, "title")}>
      {data.title}
    </h2>
    {data.content && (
      <p data-tina-field={tinaField(data, "content")}>{data.content}</p>
    )}
  </div>
  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-x-6 gap-y-12" data-tina-field={tinaField(data, "people")}>
    {people.map((person) => (
      <article data-tina-field={tinaField(person)}>
        <div class="aspect-square mb-4 overflow-hidden bg-primary-100" data-tina-field={tinaField(person, "image")}>
          {person.image ? (
            <img src={person.image} alt="" class="w-full h-full object-cover" loading="lazy" />
          ) : (
            <span class="flex h-full items-center justify-center font-serif text-4xl text-primary-500" aria-hidden="true">
              {initials(person.name)}
            </span>
          )}
        </div>
        <h3 class="font-serif text-xl leading-normal" data-tina-field={tinaField(person, "name")}>
          {person.name}
        </h3>
        {person.role && (
          <p class="font-medium text-primary-500" data-tina-field={tinaField(person, "role")}>{person.role}</p>
        )}
        {person.bio && (
          <p class="mt-2 text-sm" data-tina-field={tinaField(person, "bio")}>{person.bio}</p>
        )}
      </article>
    ))}
  </div>
</SectionContainer>
