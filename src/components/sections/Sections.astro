---
import { tinaField } from '@tinacms/astro/tina-field';

import Hero from '../hero/Hero.astro';
import LinkButton from '../link-button/LinkButton.astro';

import type { CmsPage } from '../../lib/data';

interface Props {
  data?: CmsPage | null;
}

const { data } = Astro.props;
const sections = (data?.sections ?? []).filter(s => s !== null);
---
{sections.map((section) => {
  const rendered = (() => {
    switch (section.__typename) {
      case 'PagesSectionsHero': return <Hero data={section} />;
      case 'PagesSectionsButton': return section.url && <LinkButton data={{...section, url: section.url}} />;
      default: return null;
    }
  })();
  return <div data-tina-field={tinaField(section)} class={rendered ? undefined : 'min-h-8'}>{rendered}</div>;
})}