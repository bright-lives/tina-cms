---
import { tinaField } from '@tinacms/astro/tina-field';

import Hero from '../section-hero/SectionHero.astro';
import SectionHighlight from '../section-highlight/SectionHighlight.astro';
import SectionStandoutColumns from '../section-standout-columns/SectionStandoutColumns.astro';
import SectionDisplayData from '../section-display-data/SectionDisplayData.astro';
import SectionDonate from '../section-donate/SectionDonate.astro';
import SectionIntro from '../section-intro/SectionIntro.astro';
import SectionFacts from '../section-facts/SectionFacts.astro';
import SectionCalculator from '../section-calculator/SectionCalculator.astro';
import DonationForm from '../donation-form/DonationForm.astro';
import SectionPostsOverview from '../section-posts-overview/SectionPostsOverview.astro';
import SectionSteps from '../section-steps/SectionSteps.astro';
import SectionQuote from '../section-quote/SectionQuote.astro';
import SectionPeople from '../section-people/SectionPeople.astro';
import SectionFaq from '../section-faq/SectionFaq.astro';
import SectionDownloads from '../section-downloads/SectionDownloads.astro';

import type { CmsPage } from '../../lib/data';
import { sectionLabels } from '../../lib/section-labels';

interface Props {
  data?: CmsPage | null;
}

const { data } = Astro.props;
const sections = (data?.sections ?? []).filter(s => s !== null);
// Frames each section and names it, for the examples page.
const showLabels = !!data?.showSectionLabels;
---
{sections.map((section) => {
  const rendered = (() => {
    switch (section.__typename) {
      case 'PagesSectionsHero': return <Hero data={section} />;
      case 'PagesSectionsIntro': return <SectionIntro data={section} />;
      case 'PagesSectionsHighlight': return <SectionHighlight data={section} />;
      case 'PagesSectionsStandoutColumns': return <SectionStandoutColumns data={section} />;
      case 'PagesSectionsDisplayData': return <SectionDisplayData data={section} />;
      case 'PagesSectionsFacts': return <SectionFacts data={section} />;
      case 'PagesSectionsSteps': return <SectionSteps data={section} />;
      case 'PagesSectionsQuote': return <SectionQuote data={section} />;
      case 'PagesSectionsPeople': return <SectionPeople data={section} />;
      case 'PagesSectionsCalculator': return <SectionCalculator data={section} />;
      case 'PagesSectionsPostsOverview': return <SectionPostsOverview data={section} />;
      case 'PagesSectionsFaq': return <SectionFaq data={section} />;
      case 'PagesSectionsDownloads': return <SectionDownloads data={section} />;
      case 'PagesSectionsDonate': return <SectionDonate data={section} />;
      case 'PagesSectionsDonationForm': return <DonationForm data={section} />;
      default: return null;
    }
  })();
  return (
    <div
      data-tina-field={tinaField(section)}
      class:list={[!rendered && 'min-h-8', showLabels && 'relative outline-2 outline-dashed -outline-offset-4 outline-secondary-300']}
    >
      {rendered}
      {showLabels && (
        <span class="absolute bottom-3 left-3 z-40 bg-secondary-700 px-3 py-1 text-xs font-bold uppercase tracking-wide text-white">
          {sectionLabels[section.__typename] ?? section.__typename}
        </span>
      )}
    </div>
  );
})}