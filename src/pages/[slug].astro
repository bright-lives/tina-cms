---
import Base from '../layouts/Base.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import { getPage } from '../lib/data';
import { islands } from '../lib/islands';
import PageBody from "../components/islands/PageBody.astro";

export async function getStaticPaths() {
  // Resolved at build time; the Cloudflare runtime has no filesystem access
  const files = Object.keys(
    import.meta.glob('/content/pages/*.md', { query: '?raw', import: 'default' }),
  );

  const paths = files
    .map(file => file.split('/').pop()!.replace('.md', ''))
    .filter(slug => slug !== 'homepage')
    .map(slug => ({
      params: { slug },
    }));

  return paths;
}

const { slug } = Astro.params;
const page = await getPage(slug);
const data = page.data?.pages;

if (!data) {
  return new Response(`${slug} not found`, { status: 404 });
}
---

<Base>
  <TinaIsland name="page" wrapper={islands.page.wrapper} params={{ slug }} primary>
    <PageBody data={data} />
  </TinaIsland>
</Base>
