---
import Base from '../../layouts/Base.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import { getPost } from '../../lib/data';
import { islands } from '../../lib/islands';
import PostBody from '../../components/islands/PostBody.astro';

export async function getStaticPaths() {
  // Resolved at build time; the Cloudflare runtime has no filesystem access
  const files = Object.keys(
    import.meta.glob('/content/posts/*.md', { query: '?raw', import: 'default' }),
  );

  return files.map(file => ({
    params: { slug: file.split('/').pop()!.replace('.md', '') },
  }));
}

const { slug } = Astro.params;
const post = await getPost(slug);
const data = post.data?.post;

if (!data) {
  return new Response(`${slug} not found`, { status: 404 });
}
---

<Base>
  <TinaIsland name="post" wrapper={islands.post.wrapper} params={{ slug }} primary>
    <PostBody data={data} />
  </TinaIsland>
</Base>
